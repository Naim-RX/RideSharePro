# Copy to mobile/.env after creating a NEW Supabase project.
# Project Connect panel: URL and publishable key (sb_publishable_...).
# Account access requires these values; missing config shows a controlled error.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public in the Android binary: restrict to Maps SDK for Android + package/SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=
# Never add Supabase secret/service-role keys or Google server keys here.
# Expo bundles EXPO_PUBLIC_ values into the application; they are public.
